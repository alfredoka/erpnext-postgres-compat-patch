+
+def DateDiff(end_date, start_date):
+	"""Whole days from start_date to end_date.
+
+	Postgres has no DATEDIFF; subtracting two dates yields the integer number of days, which is what
+	DATEDIFF returns on MariaDB."""
+	if frappe.db.db_type == "postgres":
+		return Cast(end_date, "date") - Cast(start_date, "date")
+	return _MariaDBDateDiff(end_date, start_date)
 
 
